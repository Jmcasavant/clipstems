# Shared editor settings. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,toml,js,mjs,cjs,ts,tsx,jsx,css,html,xml,props,csproj,slnx,ipynb}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cs]
# Analyzer suggestions that are style or micro-performance, not correctness.
dotnet_diagnostic.CA1822.severity = suggestion # member could be static
dotnet_diagnostic.CA1826.severity = suggestion # indexer instead of LINQ First()
dotnet_diagnostic.CA1848.severity = suggestion # LoggerMessage delegates; logging here is not a hot path
dotnet_diagnostic.CA1859.severity = suggestion # concrete return types
dotnet_diagnostic.CA1873.severity = suggestion # avoid evaluating logging arguments when disabled

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none # test names read as sentences with underscores
